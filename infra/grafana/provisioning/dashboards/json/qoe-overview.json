    {
      "id": 11,
      "type": "table",
      "title": "Top 错误（err_type / err_detail）",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT err_type, err_detail, countIf(fatal=1) AS fatal, count() AS total, uniq(view_id) AS views FROM qoe.events WHERE event='error' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY err_type, err_detail ORDER BY total DESC LIMIT 20",
          "format": 1,
          "refId": "A"
        }
      ],
