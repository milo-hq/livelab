    {
      "id": 6,
      "type": "stat",
      "title": "播放失败率 / EBVS",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "WITH v AS (SELECT view_id, maxIf(1, event='first_frame') ff, maxIf(1, event='error' AND fatal=1) fe, maxIf(1, event='end' AND value_ms>=1000) ex FROM qoe.events WHERE $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY view_id)\nSELECT 100*avg(fe) AS failure_pct, 100*avg(ff=0 AND fe=0 AND ex=1) AS ebvs_pct FROM v",
          "format": 1,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Mux 口径：致命错误会话占比；EBVS = 未起播且停留≥1s 即退出"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "起播 TTFF p50 / p95（ms）",
      "datasource": {
