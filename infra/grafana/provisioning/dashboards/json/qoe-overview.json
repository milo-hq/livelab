          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, quantile(0.5)(bitrate_kbps) AS bitrate_kbps, 100*sum(dropped_frames)/greatest(sum(total_frames),1) AS dropped_pct FROM qoe.events WHERE event='heartbeat' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY time ORDER BY time",
