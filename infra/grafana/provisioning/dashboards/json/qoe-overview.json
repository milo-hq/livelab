          "rawSql": "SELECT 100*uniqIf(view_id, event='stall_end')/greatest(uniqIf(view_id, event='play_attempt'),1) AS stall_view_pct FROM qoe.events WHERE $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote})",
