          "rawSql": "SELECT $__timeInterval(ts) AS time, protocol, quantile(0.5)(latency_ms) AS p50 FROM qoe.events WHERE event='latency_sample' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY time, protocol ORDER BY time",
