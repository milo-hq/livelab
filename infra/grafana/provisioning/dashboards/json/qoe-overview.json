  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "播放会话数",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT uniqIf(view_id, event='play_attempt') AS sessions FROM qoe.events WHERE $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote})",
          "format": 1,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "uniq(view_id) with a play_attempt in range"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "起播 TTFF p50 / p95",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT quantile(0.5)(value_ms) AS p50, quantile(0.95)(value_ms) AS p95 FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote})",
          "format": 1,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "first_frame.value_ms = 点击/自动播放 → 首帧"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "秒开率",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT 100*countIf(value_ms<=1000)/greatest(count(),1) AS fast_start_pct FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote})",
          "format": 1,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "TTFF ≤ 1000ms 的占比（阿里云口径）"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "百秒卡顿时长",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT 100*sumIf(value_ms, event='stall_end')/greatest(sumIf(value_ms, event='heartbeat'),1) AS stall_per_100s FROM qoe.events WHERE $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote})",
          "format": 1,
          "refId": "A"
