          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, quantile(0.5)(value_ms) AS p50, quantile(0.95)(value_ms) AS p95 FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY time ORDER BY time",
          "format": 2,
