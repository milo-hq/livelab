  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "TTFF p95 按 CDN",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT cdn, quantile(0.95)(value_ms) AS p95_ms FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY cdn ORDER BY cdn",
          "format": 1,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
