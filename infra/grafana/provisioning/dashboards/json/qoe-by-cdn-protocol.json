        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TTFF p95 按 CDN（时间序列）",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, cdn, quantile(0.95)(value_ms) AS p95 FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY time, cdn ORDER BY time",
