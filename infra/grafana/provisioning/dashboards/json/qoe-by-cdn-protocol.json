          "rawSql": "SELECT protocol, quantile(0.95)(value_ms) AS p95_ms FROM qoe.events WHERE event='first_frame' AND $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY protocol ORDER BY protocol",
          "format": 1,
          "refId": "A"
