    {
      "id": 6,
      "type": "table",
      "title": "维度汇总（浏览器 × 网络类型）",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-qoe"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-qoe"
          },
          "editorType": "sql",
          "queryType": "sql",
          "rawSql": "SELECT browser, net_type, uniqIf(view_id, event='play_attempt') AS sessions, quantile(0.5)(if(event='first_frame', value_ms, NULL)) AS ttff_p50, 100*sumIf(value_ms, event='stall_end')/greatest(sumIf(value_ms, event='heartbeat'),1) AS stall_per_100s FROM qoe.events WHERE $__timeFilter(ts) AND room_id IN (${room:singlequote}) AND cdn IN (${cdn:singlequote}) AND protocol IN (${protocol:singlequote}) GROUP BY browser, net_type ORDER BY sessions DESC LIMIT 50",
          "format": 1,
          "refId": "A"
        }
      ],
